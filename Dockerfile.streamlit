# Dockerfile.streamlit - Dashboard de pricing
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt pyproject.toml README.md ./
COPY optimization_pricing/__init__.py ./optimization_pricing/
RUN pip install -r requirements.txt

COPY optimization_pricing/ ./optimization_pricing/
COPY streamlit_app/ ./streamlit_app/
COPY models/ ./models/
COPY data/processed/ ./data/processed/

# Le dashboard privilegie l'API (variable API_URL) et retombe sur le service
# en processus si elle est injoignable : il reste utilisable meme si le
# conteneur API redemarre.
ENV API_URL=http://api:8000

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 \
    CMD curl -f http://localhost:8501/_stcore/health || exit 1

CMD ["streamlit", "run", "streamlit_app/app.py", \
     "--server.port=8501", "--server.address=0.0.0.0", \
     "--server.headless=true", "--browser.gatherUsageStats=false"]
